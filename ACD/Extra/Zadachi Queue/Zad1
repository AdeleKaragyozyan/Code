using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Domashno_Informatika
{
    class Program
    {
        static void Main(string[] args)
        {
            Random random = new Random();
            Queue<int> numbers = new Queue<int>();

            Console.Write("Въведете число N в интервала от 10 до 100: ");
            int N;
            while (!int.TryParse(Console.ReadLine(), out N) || N < 10 || N > 100)
            {
                Console.WriteLine("Невалидно число. Моля, въведете число N от интервала [10..100]: ");
            }

            for (int i = 0; i < N; i++)
            {
                numbers.Enqueue(random.Next(1, 102));
            }

            Queue<int> evenNumbers = new Queue<int>();
            Stack<int> oddNumbers = new Stack<int>();

            foreach (int number in numbers)
            {
                if (number % 2 == 0)
                {
                    evenNumbers.Enqueue(number);
                }
                else
                {
                    oddNumbers.Push(number);
                }
            }

            Console.WriteLine("Четни числа:");
            while (evenNumbers.Count > 0)
            {
                Console.Write($"{evenNumbers.Dequeue()} ");
            }

            Console.WriteLine("\nНечетни числа:");
            while (oddNumbers.Count > 0)
            {
                Console.Write($"{oddNumbers.Pop()} ");
            }
        }
    }
}
